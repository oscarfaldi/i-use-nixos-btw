[Default Applications]

# =========================
# Text
# =========================
text/plain=org.xfce.mousepad.desktop
text/markdown=org.xfce.mousepad.desktop
application/json=org.xfce.mousepad.desktop
application/x-yaml=org.xfce.mousepad.desktop
text/yaml=org.xfce.mousepad.desktop
application/x-shellscript=org.xfce.mousepad.desktop
text/x-python=org.xfce.mousepad.desktop

# =========================
# Web
# =========================
text/html=chromium.desktop
application/xhtml+xml=chromium.desktop
x-scheme-handler/http=chromium.desktop
x-scheme-handler/https=chromium.desktop
x-scheme-handler/about=chromium.desktop
x-scheme-handler/unknown=chromium.desktop

# =========================
# Images
# =========================
image/jpeg=qimgv.desktop
image/png=qimgv.desktop
image/webp=qimgv.desktop
image/gif=qimgv.desktop
image/bmp=qimgv.desktop
image/tiff=qimgv.desktop
image/svg+xml=qimgv.desktop

# Modern Image Formats
image/avif=qimgv.desktop
image/heif=qimgv.desktop
image/heic=qimgv.desktop
image/jxl=qimgv.desktop

# Icons
image/vnd.microsoft.icon=qimgv.desktop
image/x-icon=qimgv.desktop

# Photoshop & GIMP
image/vnd.adobe.photoshop=qimgv.desktop
image/x-xcf=qimgv.desktop

# RAW Photos
image/x-canon-cr2=qimgv.desktop
image/x-canon-cr3=qimgv.desktop
image/x-nikon-nef=qimgv.desktop
image/x-sony-arw=qimgv.desktop
image/x-panasonic-rw2=qimgv.desktop
image/x-fuji-raf=qimgv.desktop
image/x-olympus-orf=qimgv.desktop
image/x-adobe-dng=qimgv.desktop

# =========================
# Video
# =========================
video/mp4=mpv.desktop
video/x-matroska=mpv.desktop
video/webm=mpv.desktop
video/ogg=mpv.desktop
video/x-msvideo=mpv.desktop
video/avi=mpv.desktop
video/x-ms-wmv=mpv.desktop
video/quicktime=mpv.desktop
video/mpeg=mpv.desktop
video/mp2t=mpv.desktop
video/MP2T=mpv.desktop
video/x-m4v=mpv.desktop
video/x-flv=mpv.desktop
video/3gpp=mpv.desktop
video/3gpp2=mpv.desktop

# =========================
# Audio
# =========================
audio/mpeg=mpv.desktop
audio/flac=mpv.desktop
audio/x-flac=mpv.desktop
audio/ogg=mpv.desktop
audio/opus=mpv.desktop
audio/x-opus+ogg=mpv.desktop
audio/webm=mpv.desktop
audio/wav=mpv.desktop
audio/x-wav=mpv.desktop
audio/vnd.wave=mpv.desktop
audio/mp4=mpv.desktop
audio/aac=mpv.desktop
audio/x-matroska=mpv.desktop

# =========================
# PDF
# =========================
application/pdf=atril.desktop

# =========================
# Microsoft Office (OnlyOffice)
# =========================

# Word
application/msword=onlyoffice-desktopeditors.desktop
application/vnd.openxmlformats-officedocument.wordprocessingml.document=onlyoffice-desktopeditors.desktop
application/vnd.openxmlformats-officedocument.wordprocessingml.template=onlyoffice-desktopeditors.desktop

# Excel
application/vnd.ms-excel=onlyoffice-desktopeditors.desktop
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=onlyoffice-desktopeditors.desktop
application/vnd.openxmlformats-officedocument.spreadsheetml.template=onlyoffice-desktopeditors.desktop

# PowerPoint
application/vnd.ms-powerpoint=onlyoffice-desktopeditors.desktop
application/vnd.openxmlformats-officedocument.presentationml.presentation=onlyoffice-desktopeditors.desktop
application/vnd.openxmlformats-officedocument.presentationml.slideshow=onlyoffice-desktopeditors.desktop
application/vnd.openxmlformats-officedocument.presentationml.template=onlyoffice-desktopeditors.desktop

# OpenDocument
application/vnd.oasis.opendocument.text=onlyoffice-desktopeditors.desktop
application/vnd.oasis.opendocument.spreadsheet=onlyoffice-desktopeditors.desktop
application/vnd.oasis.opendocument.presentation=onlyoffice-desktopeditors.desktop

# =========================
# Archives
# =========================
application/zip=xarchiver.desktop
application/x-7z-compressed=xarchiver.desktop
application/x-rar=xarchiver.desktop
application/vnd.rar=xarchiver.desktop
application/x-tar=xarchiver.desktop
application/gzip=xarchiver.desktop
application/x-bzip2=xarchiver.desktop
application/x-xz=xarchiver.desktop
application/zstd=xarchiver.desktop
application/x-iso9660-image=xarchiver.desktop
