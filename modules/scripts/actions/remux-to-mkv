#!/usr/bin/env bash

set -euo pipefail

# ============================================================
# Remux to MKV
#
# Remux selected videos to MKV without re-encoding.
#
# Video:
#   Codec        : Copy
#
# Audio:
#   Codec        : Copy
#
# Streams:
#   All streams are copied unchanged.
#
# Container:
#   MKV
#
# Output:
#   `<filename>.mkv`
#
# Supports:
#   - Single file
#   - Multiple selected files
#
# Intended for Thunar Custom Actions using %F.
# ============================================================

notify() {
    notify-send "$1" "$2"
}

is_video_file() {
    case "${1,,}" in
        *.mkv|*.mp4|*.m4v|*.mov|*.avi|*.wmv|*.asf|*.webm|*.mpg|*.mpeg|*.m2ts|*.mts|*.ts|*.mxf|*.flv|*.f4v|*.ogv|*.3gp|*.3g2|*.vob|*.divx)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

format_elapsed() {
    local seconds="$1"

    local hours=$((seconds / 3600))
    local minutes=$(((seconds % 3600) / 60))
    local secs=$((seconds % 60))

    printf "%02d:%02d:%02d" "$hours" "$minutes" "$secs"
}

# ============================================================
# Validate / Collect Files
# ============================================================

files=()

if [[ "$#" -eq 0 ]]; then
    notify \
        "Remux to MKV" \
        "No input file specified."

    echo
    echo "No input file specified."
    echo
    read -r -p "Press Enter to close..."
    exit 1
fi

for input in "$@"; do

    if [[ -f "$input" ]]; then

        if is_video_file "$input"; then
            files+=("$input")
        else
            notify \
                "Remux to MKV" \
                "$(basename "$input") is not a supported video file."

            echo
            echo "[SKIP] $(basename "$input") is not a supported video file."
        fi

    else

        notify \
            "Remux to MKV" \
            "Invalid path: $(basename "$input")"

        echo
        echo "[SKIP] Invalid path: $input"

    fi

done

total=${#files[@]}

if [[ "$total" -eq 0 ]]; then
    echo
    echo "No supported videos found."
    echo
    notify \
        "Remux to MKV" \
        "No supported videos found."

    read -r -p "Press Enter to close..."
    exit 0
fi

# ============================================================
# Session State
# ============================================================

current=0
success=0
failed=0
skipped=0

total_original=0
total_final=0

session_start=$(date +%s)

tmp=""
ffmpeg_log=""

cleanup() {
    echo
    echo
    echo "============================================================"
    echo " CANCELLED"
    echo "============================================================"
    echo

    if [[ -n "$tmp" && -f "$tmp" ]]; then
        rm -f "$tmp"
    fi

    if [[ -n "$ffmpeg_log" && -f "$ffmpeg_log" ]]; then
        rm -f "$ffmpeg_log"
    fi

    echo "Temporary output removed."
    echo "Source files were not intentionally deleted."
    echo

    notify \
        "Remux Cancelled" \
        "The remux operation was interrupted."

    read -r -p "Press Enter to close..."
    exit 130
}

trap cleanup INT TERM

# ============================================================
# Header
# ============================================================

echo
echo "============================================================"
echo " REMUX TO MKV"
echo "============================================================"
echo "Files       : $total"
echo "Video       : Copy"
echo "Audio       : Copy"
echo "Streams     : All"
echo "Container   : MKV"
echo "Re-encode   : No"
echo "============================================================"

# ============================================================
# Process Files
# ============================================================

for input in "${files[@]}"; do

    current=$((current + 1))

    filename="$(basename "$input")"
    extension_lower="${input##*.}"
    extension_lower="${extension_lower,,}"

    # Already in the requested container.
    if [[ "$extension_lower" == "mkv" ]]; then
        skipped=$((skipped + 1))

        echo
        echo "============================================================"
        echo "[$current/$total] $filename"
        echo "============================================================"
        echo
        echo "[SKIP] Already a MKV file."
        continue
    fi

    output="${input%.*}.mkv"
    tmp="${output}.remux-tmp.mkv"
    ffmpeg_log="${tmp}.log"

    rm -f "$tmp" "$ffmpeg_log"

    echo
    echo "============================================================"
    echo "[$current/$total] $filename"
    echo "============================================================"
    echo "Source : $input"
    echo "Output : $output"
    echo

    original_size=$(stat -c%s "$input")
    remux_start=$(date +%s)

    ffmpeg \
        -hide_banner \
        -loglevel warning \
        -i "$input" \
        -map 0 \
        -c copy \
\
        -y \
        -progress pipe:1 \
        -nostats \
        "$tmp" \
        2>"$ffmpeg_log" |
    while IFS="=" read -r key value; do

        if [[ "$key" == "out_time_us" ]]; then
            current_us="$value"

            current_seconds=$((current_us / 1000000))
            elapsed=$(( $(date +%s) - remux_start ))

            if (( elapsed > 0 )); then
                speed=$(awk \
                    -v current="$current_seconds" \
                    -v elapsed="$elapsed" \
                    'BEGIN {
                        printf "%.2f", current/elapsed
                    }')
            else
                speed="0.00"
            fi

            printf "\rProcessed: %s | Speed: %sx" \
                "$(format_elapsed "$current_seconds")" \
                "$speed"
        fi

    done

    ffmpeg_exit_code=${PIPESTATUS[0]}

    echo

    # ========================================================
    # Success
    # ========================================================

    if [[ "$ffmpeg_exit_code" -eq 0 && -s "$tmp" ]]; then

        touch -r "$input" "$tmp"

        final_size=$(stat -c%s "$tmp")

        total_original=$((total_original + original_size))
        total_final=$((total_final + final_size))

        remux_elapsed=$(( $(date +%s) - remux_start ))

        size_difference=$((final_size - original_size))

        mv -f "$tmp" "$output"
        rm -f "$input"

        echo
        echo "[OK] Remux complete!"
        echo
        echo "Source : $(numfmt --to=iec "$original_size")"
        echo "Output : $(numfmt --to=iec "$final_size")"

        if [[ "$size_difference" -lt 0 ]]; then

            saved=$((-size_difference))

            saved_percent=$(awk \
                -v original="$original_size" \
                -v final="$final_size" \
                'BEGIN {
                    printf "%.1f", (1-final/original)*100
                }')

            echo "Saved  : $(numfmt --to=iec "$saved") (-$saved_percent%)"

        elif [[ "$size_difference" -gt 0 ]]; then

            increase="$size_difference"

            increase_percent=$(awk \
                -v original="$original_size" \
                -v final="$final_size" \
                'BEGIN {
                    printf "%.1f", (final/original-1)*100
                }')

            echo "Saved  : +$(numfmt --to=iec "$increase") (+$increase_percent%)"

        else

            echo "Saved  : 0 B (0.0%)"

        fi

        printf "Elapsed: %s\n" "$(format_elapsed "$remux_elapsed")"
        echo "Output : $(basename "$output")"

        success=$((success + 1))

    # ========================================================
    # Failure
    # ========================================================

    else

        echo
        echo "[FAILED] Remux failed."
        echo
        echo "Source file preserved."
        echo "Temporary output removed."

        if [[ -s "$ffmpeg_log" ]]; then
            echo
            echo "FFmpeg output:"
            echo "------------------------------------------------------------"

            sed 's/^/  /' "$ffmpeg_log"

            echo "------------------------------------------------------------"
        else
            echo
            echo "FFmpeg did not provide additional error output."
            echo "Exit code: $ffmpeg_exit_code"
        fi

        rm -f "$tmp"

        failed=$((failed + 1))

    fi

    rm -f "$ffmpeg_log"

    tmp=""
    ffmpeg_log=""

done

# ============================================================
# Summary
# ============================================================

session_end=$(date +%s)
session_elapsed=$((session_end - session_start))

echo
echo
echo "============================================================"
echo " REMUX TO MKV COMPLETE"
echo "============================================================"
echo "Processed     : $current/$total"
echo "Successful    : $success"
echo "Skipped       : $skipped"
echo "Failed        : $failed"
echo

echo "Original size : $(numfmt --to=iec "$total_original")"
echo "Final size    : $(numfmt --to=iec "$total_final")"

if [[ "$total_original" -gt 0 ]]; then

    total_difference=$((total_final - total_original))

    if [[ "$total_difference" -lt 0 ]]; then

        total_saved=$((-total_difference))

        total_saved_percent=$(awk \
            -v original="$total_original" \
            -v final="$total_final" \
            'BEGIN {
                printf "%.1f", (1-final/original)*100
            }')

        echo "Space saved   : $(numfmt --to=iec "$total_saved") (-$total_saved_percent%)"

    elif [[ "$total_difference" -gt 0 ]]; then

        total_increase="$total_difference"

        total_increase_percent=$(awk \
            -v original="$total_original" \
            -v final="$total_final" \
            'BEGIN {
                printf "%.1f", (final/original-1)*100
            }')

        echo "Saved         : +$(numfmt --to=iec "$total_increase") (+$total_increase_percent%)"

    else

        echo "Saved         : 0 B (0.0%)"

    fi

else

    echo "Space change  : N/A"

fi

echo
echo "Elapsed       : $(format_elapsed "$session_elapsed")"

echo
echo "============================================================"
echo

if (( failed > 0 )); then
    notify \
        "Remux to MKV Finished" \
        "$success successful, $failed failed, $skipped skipped."
else
    notify \
        "Remux to MKV Complete" \
        "$success successful, $skipped skipped."
fi

read -r -p "Press Enter to close..."
