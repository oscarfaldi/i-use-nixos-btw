#!/usr/bin/env bash

set -euo pipefail

# ============================================================
# Remux to MP4
#
# Remux selected videos into MP4 without re-encoding.
#
# Video:
#   Stream copy
#
# Audio:
#   Stream copy
#
# Re-encode:
#   No
#
# Container:
#   MP4
#
# Notes:
#   - Only MP4-compatible video/audio streams are copied.
#   - Subtitle and data streams are not forced into the output.
#
# Output:
#   <filename>-remuxed.mp4
#
# Supports:
#   - Single file
#   - Multiple selected files
#   - Folder selection (non-recursive)
#
# Intended for Thunar Custom Actions using %F.
# ============================================================

notify() {
    notify-send "$1" "$2"
}

get_output_path() {
    local input="$1"
    echo "${input%.*}-remuxed.mp4"
}

is_video_file() {
    case "${1,,}" in
        *.mkv|*.mp4|*.m4v|*.mov|*.avi|*.wmv|*.asf|*.webm|*.mpg|*.mpeg|*.m2ts|*.mts|*.ts|*.mxf|*.flv|*.f4v|*.ogv|*.3gp|*.3g2|*.vob|*.divx)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# ============================================================
# Collect Files
# ============================================================

files=()

if [[ "$#" -eq 0 ]]; then

    notify \
        "Remux to MP4" \
        "No input file or folder specified."

    exit 1

fi

for input in "$@"; do

    if [[ -d "$input" ]]; then

        while IFS= read -r -d '' file; do

            if is_video_file "$file"; then
                files+=("$file")
            fi

        done < <(
            find "$input" \
                -maxdepth 1 \
                -type f \
                -print0
        )

    elif [[ -f "$input" ]]; then

        if is_video_file "$input"; then
            files+=("$input")
        else
            notify \
                "Remux to MP4" \
                "$(basename "$input") is not a supported video file."
        fi

    else

        notify \
            "Remux to MP4" \
            "Invalid path: $(basename "$input")"

    fi

done

total=${#files[@]}

if [[ "$total" -eq 0 ]]; then

    notify \
        "Remux to MP4" \
        "No supported videos found."

    exit 0

fi

# ============================================================
# Launch Processing Session
# ============================================================

set +e

ghostty \
    --title="Remux to MP4" \
    -e bash -c '
        set -u

        files=( "$@" )

        total=${#files[@]}
        current=0
        success=0
        failed=0
        skipped=0

        total_original=0
        total_final=0

        session_start=$(date +%s)

        tmp=""
        ffmpeg_log=""

        cleanup() {
            echo
            echo
            echo "Interrupted."

            [[ -n "$tmp" && -f "$tmp" ]] && rm -f "$tmp"
            [[ -n "$ffmpeg_log" && -f "$ffmpeg_log" ]] && rm -f "$ffmpeg_log"

            echo
            echo "Source files were not intentionally deleted."
            echo
            read -r -p "Press Enter to close..."

            exit 130
        }

        trap cleanup INT TERM

        echo
        echo "============================================================"
        echo " REMUX TO MP4"
        echo "============================================================"
        echo "Files       : $total"
        echo "Mode        : Stream copy"
        echo "Re-encode   : No"
        echo "Container   : MP4"
        echo "Faststart   : Enabled"
        echo "============================================================"

        for input in "${files[@]}"; do

            current=$((current + 1))

            filename="$(basename "$input")"

            # Already MP4: skip because there is nothing to remux.
            if [[ "${input,,}" == *.mp4 ]]; then

                echo
                echo "============================================================"
                echo "[$current/$total] $filename"
                echo "============================================================"
                echo
                echo "[SKIPPED] File is already an MP4."
                echo

                skipped=$((skipped + 1))

                continue
            fi

            output="${input%.*}-remuxed.mp4"

            tmp="${output}.remux-tmp.mp4"
            ffmpeg_log="${tmp}.log"

            rm -f "$tmp" "$ffmpeg_log"

            echo
            echo "============================================================"
            echo "[$current/$total] $filename"
            echo "============================================================"
            echo "Source : $input"
            echo "Output : $output"
            echo

            duration=$(ffprobe \
                -v error \
                -show_entries format=duration \
                -of default=noprint_wrappers=1:nokey=1 \
                "$input")

            if [[ -z "$duration" ]]; then

                echo "[FAILED] Could not determine video duration."
                echo "Source file preserved."

                failed=$((failed + 1))

                rm -f "$tmp" "$ffmpeg_log"

                tmp=""
                ffmpeg_log=""

                continue
            fi

            original_size=$(stat -c%s "$input")
            remux_start=$(date +%s)

            ffmpeg \
                -hide_banner \
                -loglevel warning \
                -i "$input" \
                -map 0:v:0 \
                -map 0:a? \
                -c:v copy \
                -c:a copy \
                -movflags +faststart \
                -y \
                -progress pipe:1 \
                -nostats \
                "$tmp" \
                2>"$ffmpeg_log" |
            while IFS="=" read -r key value; do

                if [[ "$key" == "out_time_us" ]]; then

                    current_us="$value"

                    current_seconds=$(awk \
                        "BEGIN {print $current_us / 1000000}")

                    percent=$(awk \
                        -v current="$current_seconds" \
                        -v total="$duration" \
                        "BEGIN {
                            if (total > 0)
                                printf \"%.1f\", (current / total) * 100
                            else
                                print \"0.0\"
                        }")

                    elapsed=$(($(date +%s) - remux_start))

                    speed=$(awk \
                        -v current="$current_seconds" \
                        -v elapsed="$elapsed" \
                        "BEGIN {
                            if (elapsed > 0)
                                printf \"%.2f\", current / elapsed
                            else
                                print \"0.00\"
                        }")

                    eta=$(awk \
                        -v current="$current_seconds" \
                        -v total="$duration" \
                        -v elapsed="$elapsed" \
                        "BEGIN {
                            if (current > 0)
                                printf \"%.0f\", (total-current)*elapsed/current
                            else
                                print 0
                        }")

                    eta_h=$((eta / 3600))
                    eta_m=$(((eta % 3600) / 60))
                    eta_s=$((eta % 60))

                    printf "\rProgress: %6s%% | Speed: %5sx | ETA: %02d:%02d:%02d" \
                        "$percent" \
                        "$speed" \
                        "$eta_h" \
                        "$eta_m" \
                        "$eta_s"

                fi

            done

            ffmpeg_exit_code=${PIPESTATUS[0]}

            echo

            # ==================================================
            # Success
            # ==================================================

            if [[ "$ffmpeg_exit_code" -eq 0 && -s "$tmp" ]]; then

                touch -r "$input" "$tmp"

                final_size=$(stat -c%s "$tmp")

                total_original=$((total_original + original_size))
                total_final=$((total_final + final_size))

                remux_elapsed=$(($(date +%s) - remux_start))

                remux_h=$((remux_elapsed / 3600))
                remux_m=$(((remux_elapsed % 3600) / 60))
                remux_s=$((remux_elapsed % 60))

                size_difference=$((final_size - original_size))

                mv -f "$tmp" "$output"
                rm -f "$input"

                echo
                echo "[OK] Remux complete!"
                echo
                echo "Source : $(numfmt --to=iec "$original_size")"
                echo "Output : $(numfmt --to=iec "$final_size")"

                if [[ "$size_difference" -lt 0 ]]; then

                    saved=$((-size_difference))

                    saved_percent=$(awk \
                        -v original="$original_size" \
                        -v final="$final_size" \
                        "BEGIN {
                            printf \"%.1f\", (1-final/original)*100
                        }")

                    echo "Saved  : $(numfmt --to=iec "$saved") (-$saved_percent%)"

                elif [[ "$size_difference" -gt 0 ]]; then

                    increase="$size_difference"

                    increase_percent=$(awk \
                        -v original="$original_size" \
                        -v final="$final_size" \
                        "BEGIN {
                            printf \"%.1f\", (final/original-1)*100
                        }")

                    echo "Saved  : +$(numfmt --to=iec "$increase") (+$increase_percent%)"

                else

                    echo "Saved  : 0 B (0.0%)"

                fi

                printf "Elapsed: %02d:%02d:%02d\n" \
                    "$remux_h" \
                    "$remux_m" \
                    "$remux_s"

                echo "Output : $(basename "$output")"

                success=$((success + 1))

            # ==================================================
            # Failure
            # ==================================================

            else

                echo
                echo "[FAILED] Remux failed."
                echo
                echo "Source file preserved."
                echo "Temporary output removed."

                if [[ -s "$ffmpeg_log" ]]; then

                    echo
                    echo "FFmpeg output:"
                    echo "------------------------------------------------------------"

                    sed "s/^/  /" "$ffmpeg_log"

                    echo "------------------------------------------------------------"

                else

                    echo
                    echo "FFmpeg did not provide additional error output."
                    echo "Exit code: $ffmpeg_exit_code"

                fi

                rm -f "$tmp"

                failed=$((failed + 1))

            fi

            rm -f "$ffmpeg_log"

            tmp=""
            ffmpeg_log=""

        done

        # ====================================================
        # Summary
        # ====================================================

        session_end=$(date +%s)
        session_elapsed=$((session_end - session_start))

        echo
        echo
        echo "============================================================"
        echo " REMUX COMPLETE"
        echo "============================================================"
        echo "Processed     : $current/$total"
        echo "Successful    : $success"
        echo "Skipped       : $skipped"
        echo "Failed        : $failed"
        echo

        echo "Original size : $(numfmt --to=iec "$total_original")"
        echo "Final size    : $(numfmt --to=iec "$total_final")"

        if [[ "$total_original" -gt 0 ]]; then

            total_difference=$((total_final - total_original))

            if [[ "$total_difference" -lt 0 ]]; then

                total_saved=$((-total_difference))

                total_saved_percent=$(awk \
                    -v original="$total_original" \
                    -v final="$total_final" \
                    "BEGIN {
                        printf \"%.1f\", (1-final/original)*100
                    }")

                echo "Space saved   : $(numfmt --to=iec "$total_saved") (-$total_saved_percent%)"

            elif [[ "$total_difference" -gt 0 ]]; then

                total_increase="$total_difference"

                total_increase_percent=$(awk \
                    -v original="$total_original" \
                    -v final="$total_final" \
                    "BEGIN {
                        printf \"%.1f\", (final/original-1)*100
                    }")

                echo "Saved         : +$(numfmt --to=iec "$total_increase") (+$total_increase_percent%)"

            else

                echo "Saved         : 0 B (0.0%)"

            fi

        else

            echo "Space change  : N/A"

        fi

        session_h=$((session_elapsed / 3600))
        session_m=$(((session_elapsed % 3600) / 60))
        session_s=$((session_elapsed % 60))

        echo
        printf "Elapsed       : %02d:%02d:%02d\n" \
            "$session_h" \
            "$session_m" \
            "$session_s"

        echo
        echo "============================================================"
        echo

        read -r -p "Press Enter to close..."

    ' _ "${files[@]}"

status=$?

set -e

exit "$status"
