#!/usr/bin/env bash

set -euo pipefail

# ============================================================
# Re-encode and Compress to HEVC MP4
#
# Re-encode videos to HEVC for long-term storage using
# NVIDIA NVENC, with the goal of reducing file size while
# maintaining broad playback compatibility.
#
# Video:
#   Codec        : HEVC (H.265)
#   Profile      : Main
#   Preset       : P5
#   Rate Control : Constant QP (24)
#   Lookahead    : 20
#   Spatial AQ   : ON
#   AQ Strength  : 4
#   Tag          : hvc1 (Apple compatibility)
#
# Audio:
#   Copy original stream
#
# Container:
#   MP4
#
# Output:
#   <filename>-encoded.mp4
#
# Supports:
#   - Single file
#   - Multiple selected files
#   - Folder selection (non-recursive)
#
# Intended for Thunar Custom Actions using %F.
# ============================================================

notify() {
    notify-send "$1" "$2"
}

get_output_path() {
    local input="$1"
    echo "${input%.*}-encoded.mp4"
}

is_video_file() {
    case "${1,,}" in
        *.mkv|*.mp4|*.m4v|*.mov|*.avi|*.wmv|*.asf|*.webm|*.mpg|*.mpeg|*.m2ts|*.mts|*.ts|*.mxf|*.flv|*.f4v|*.ogv|*.3gp|*.3g2|*.vob|*.divx)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

run_ffmpeg() {
    local input="$1"
    local output="$2"
    local duration
    local status

    duration=$(ffprobe \
        -v error \
        -show_entries format=duration \
        -of default=noprint_wrappers=1:nokey=1 \
        "$input")

    set +e

    ghostty \
        --title="Re-encode and Compress to HEVC MP4" \
        -e bash -c "
            DURATION=$duration

            echo
            echo '============================================================'
            echo ' Re-encode and Compress to HEVC MP4'
            echo '============================================================'
            echo
            echo 'Input : $input'
            echo 'Output: $output'
            echo
            echo 'Codec  : HEVC'
            echo 'Preset : P5'
            echo 'QP     : 24'
            echo 'Audio  : Copy'
            echo 'Format : MP4'
            echo 'Tag    : hvc1'
            echo
            echo '============================================================'
            echo

            ffmpeg \
                -hide_banner \
                -nostats \
                -progress pipe:1 \
                -hwaccel_device 0 \
                -hwaccel cuda \
                -init_hw_device cuda=hw \
                -filter_hw_device hw \
                -hwaccel_output_format cuda \
                -i \"$input\" \
                -map 0:v:0 \
                -map '0:a?' \
                -sn \
                -dn \
                -c:v hevc_nvenc \
                -gpu 0 \
                -preset p5 \
                -profile:v main \
                -tag:v hvc1 \
                -rc constqp \
                -qp 24 \
                -rc-lookahead 20 \
                -spatial-aq 1 \
                -aq-strength 4 \
                -c:a copy \
                -movflags +faststart \
                -y \"$output\" |
            while IFS='=' read -r key value; do
                if [[ \"\$key\" == 'out_time_ms' ]]; then
                    PERCENT=\$(awk -v t=\"\$value\" -v d=\"\$DURATION\" 'BEGIN {
                        p=(t/1000000)/d*100
                        if (p>100) p=100
                        printf \"%.1f\", p
                    }')
                    printf '\rProgress: %5s%%' \"\$PERCENT\"
                elif [[ \"\$key\" == 'progress' && \"\$value\" == 'end' ]]; then
                    printf '\rProgress: 100.0%%\n'
                fi
            done

            STATUS=\${PIPESTATUS[0]}

            echo

            if [ \$STATUS -ne 0 ]; then
                echo
                echo -e '\e[1;31m[ERROR] Re-encode and compression failed!\e[0m'
                echo
                echo 'Output file will be removed.'
                rm -f \"$output\"
                echo
                echo 'Closing window in 5 seconds...'
                sleep 5
            else
                echo
                echo -e '\e[1;32m[OK] Re-encode and compression complete!\e[0m'
                echo
                echo 'Output:'
                echo \"$output\"
                echo
                echo 'Closing window in 5 seconds...'
                sleep 5
            fi

            exit \$STATUS
        "

    status=$?

    set -e

    return "$status"
}

process_file() {
    local input="$1"
    local output

    if ! is_video_file "$input"; then
        notify \
            "Re-encode and Compress to HEVC MP4" \
            "$(basename "$input") is not a supported video file."

        return 0
    fi

    output="$(get_output_path "$input")"

    notify \
        "Re-encode and Compress to HEVC MP4" \
        "Processing $(basename "$input")"

    if run_ffmpeg "$input" "$output"; then

        touch -r "$input" "$output"

        notify \
            "Re-encode and Compress to HEVC MP4" \
            "$(basename "$output") completed."

    else

        rm -f "$output"

        notify \
            "Re-encode and Compress to HEVC MP4" \
            "$(basename "$input") failed."

        return 1
    fi
}

process_folder() {
    local folder="$1"
    local found=0

    while IFS= read -r -d '' file; do
        found=1
        process_file "$file"
    done < <(
        find "$folder" \
            -maxdepth 1 \
            -type f \
            -print0
    )

    if [[ "$found" -eq 0 ]]; then
        notify \
            "Re-encode and Compress to HEVC MP4" \
            "No supported videos found in $(basename "$folder")."
    fi
}

# ============================================================
# Main
# ============================================================

if [[ "$#" -eq 0 ]]; then
    notify \
        "Re-encode and Compress to HEVC MP4" \
        "No input file or folder specified."

    exit 1
fi

for input in "$@"; do

    if [[ -d "$input" ]]; then
        process_folder "$input"

    elif [[ -f "$input" ]]; then
        process_file "$input"

    else
        notify \
            "Re-encode and Compress to HEVC MP4" \
            "Invalid path: $(basename "$input")"
    fi

done
