#!/usr/bin/env bash

set -uo pipefail

# ==============================================================
# NAS CIFS Recovery Tool
#
# Purpose:
#   Emergency recovery for persistent CIFS mounts.
#
# Philosophy:
#   NAS is assumed to be broken.
#   Do not check whether it is reachable first.
#   Tear down all CIFS mounts and recreate them.
#
# Usage:
#   nas-recover
# ==============================================================

SHARES=(
    academy
    archive
    download
    family
    games
    media-music
    media-video
    mulino
    oscarfaldi
    personalbranding
    snapshot
    toolkit
    valhalla
    appdata
)

UMOUNT_TIMEOUT=5
MOUNT_TIMEOUT=10

# ==============================================================
# Helpers
# ==============================================================

print_header() {
    clear 2>/dev/null || true

    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo " NAS CIFS Recovery"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo
}

mount_path() {
    printf '/mnt/nas/%s' "$1"
}

mount_unit() {
    systemd-escape \
        --path \
        --suffix=mount \
        "/mnt/nas/$1"
}

# ==============================================================
# Step 1: Tear down all mounts
# ==============================================================

unmount_all() {
    echo "→ [1/4] Lazy-unmounting all NAS shares..."
    echo

    for share in "${SHARES[@]}"; do
        local mount
        mount="$(mount_path "$share")"

        printf "  %-20s" "$share"

        if ! mountpoint -q "$mount" 2>/dev/null; then
            echo "not mounted"
            continue
        fi

        if timeout "$UMOUNT_TIMEOUT" \
            sudo umount -l "$mount" >/dev/null 2>&1; then
            echo "✓ detached"
        else
            echo "⚠ detach failed"
        fi
    done
}

# ==============================================================
# Step 2: Reset systemd mount state
# ==============================================================

reset_mount_units() {
    echo
    echo "→ [2/4] Resetting systemd mount units..."
    echo

    for share in "${SHARES[@]}"; do
        local unit
        unit="$(mount_unit "$share")"

        # Do not let a broken mount block the recovery process.
        sudo systemctl reset-failed "$unit" >/dev/null 2>&1 || true
        sudo systemctl stop "$unit" >/dev/null 2>&1 || true
    done

    echo "  ✓ Systemd mount state reset"
}

# ==============================================================
# Step 3: Start all mounts again
# ==============================================================

mount_all() {
    echo
    echo "→ [3/4] Starting all NAS mounts..."
    echo

    local failed=0

    for share in "${SHARES[@]}"; do
        local unit
        unit="$(mount_unit "$share")"

        printf "  %-20s" "$share"

        if timeout "$MOUNT_TIMEOUT" \
            sudo systemctl start "$unit" >/dev/null 2>&1; then
            echo "✓ mounted"
        else
            echo "✗ FAILED"
            failed=1
        fi
    done

    return "$failed"
}

# ==============================================================
# Step 4: Verify filesystem response
# ==============================================================

verify_all() {
    echo
    echo "→ [4/4] Verifying all NAS shares..."
    echo

    local failed=0

    for share in "${SHARES[@]}"; do
        local mount
        mount="$(mount_path "$share")"

        printf "  %-20s" "$share"

        if ! mountpoint -q "$mount" 2>/dev/null; then
            echo "✗ NOT MOUNTED"
            failed=1
            continue
        fi

        if timeout 5 ls "$mount" >/dev/null 2>&1; then
            echo "✓ OK"
        else
            echo "✗ NO RESPONSE"
            failed=1
        fi
    done

    return "$failed"
}

# ==============================================================
# Main
# ==============================================================

print_header

echo "Emergency recovery mode."
echo "All NAS mounts will be detached and recreated."
echo

unmount_all
reset_mount_units

echo
echo "→ Waiting for mount state to settle..."
sleep 1

if ! mount_all; then
    echo
    echo "⚠ Some mounts failed to start."
    echo
fi

if ! verify_all; then
    echo
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo " ⚠ Recovery completed with failures."
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo
    echo "Useful diagnostics:"
    echo
    echo "  findmnt -t cifs"
    echo "  systemctl --failed"
    echo "  journalctl -k -b | grep -Ei 'cifs|smb|ixgbe|link'"
    echo
    exit 1
fi

echo
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo " ✓ All NAS shares recovered successfully."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo
